#include "runtime.h"

int main(void) {
    Imagem *im_foto = img_load("foto.jpg");
    if (!im_foto) return 1;
    if (img_crop(im_foto, 10, 20, 300, 200) != 0) { img_destroy(im_foto); return 1; }
    if (img_save(im_foto, "resultado.jpg") != 0) { img_destroy(im_foto); return 1; }
    img_destroy(im_foto);
    return 0;
}
