#include "runtime.h"

int main(void) {
    Imagem *im_f = img_load("f.png");
    if (!im_f) return 1;
    Imagem *im_g = img_load("g.png");
    if (!im_g) { img_destroy(im_f); return 1; }
    if (img_grayscale(im_f) != 0) { img_destroy(im_f); img_destroy(im_g); return 1; }
    if (img_rotate(im_g, 90) != 0) { img_destroy(im_f); img_destroy(im_g); return 1; }
    if (img_save(im_f, "f2.png") != 0) { img_destroy(im_f); img_destroy(im_g); return 1; }
    if (img_save(im_g, "g2.png") != 0) { img_destroy(im_f); img_destroy(im_g); return 1; }
    img_destroy(im_f);
    img_destroy(im_g);
    return 0;
}
