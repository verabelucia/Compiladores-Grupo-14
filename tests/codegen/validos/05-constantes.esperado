#include "runtime.h"

int main(void) {
    Imagem *im_foto = img_load("foto.jpg");
    if (!im_foto) return 1;
    if (img_resize(im_foto, 640, 480) != 0) { img_destroy(im_foto); return 1; }
    if (img_rotate(im_foto, 270) != 0) { img_destroy(im_foto); return 1; }
    if (img_save(im_foto, "resultado.png") != 0) { img_destroy(im_foto); return 1; }
    img_destroy(im_foto);
    return 0;
}
